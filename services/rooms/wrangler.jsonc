{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "independents-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Cloudflareworkers.unsafe064@passmail.net's Account
  "account_id": "7ba8903b01eb5ef9dde5d081179d3811",

  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "vars": {
    // Comma-separated origins allowed to open rooms. Empty = public.
    "ALLOWED_ORIGINS": ""
  },

  // The cinematicgenius007.com zone lives on this same account, so Cloudflare
  // creates the DNS record and certificate on deploy.
  // Keep the old *.workers.dev URL alive so already-built apps keep working.
  "workers_dev": true,
  "routes": [{ "pattern": "rooms.cinematicgenius007.com", "custom_domain": true }]
}
