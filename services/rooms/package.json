{
  "name": "independents-rooms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multiplayer rooms for every app in independents: one Durable Object per room, sequenced relay, presence, optional replay log.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "type-check": "tsc --noEmit && tsc --noEmit -p client",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "tail": "wrangler tail",
    "test:worker": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "sync-client": "node scripts/sync-client.mjs"
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261007.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.148.0"
  }
}
